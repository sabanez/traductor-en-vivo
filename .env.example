# Clave de API de Soniox (console.soniox.com > API keys). Necesita el permiso "Temporary API keys".
SONIOX_API_KEY=
# Región de Soniox: "eu" (datos en la UE, hay que solicitarla en la consola) o "global".
SONIOX_REGION=eu

PORT=3001

# Contraseña para entrar en la web (recomendada si la publicas). Vacía = sin contraseña.
ACCESS_PASSWORD=
